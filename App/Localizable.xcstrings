{
  "sourceLanguage" : "en",
  "strings" : {
    "Make every photo\nlook considered." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her fotoğraf\nözenle hazırlanmış görünsün."
          }
        }
      }
    },
    "Pick a photo, choose a look, export. Most edits take less than ten seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fotoğraf seç, bir görünüm belirle, dışa aktar. Çoğu düzenleme on saniyeden kısa sürer."
          }
        }
      }
    },
    "Choose your aesthetic" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetiğini seç"
          }
        }
      }
    },
    "Pick up to three. We'll start your edits from these." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla üç tane seç. Düzenlemelerine bunlarla başlayacağız."
          }
        }
      }
    },
    "Your photos stay yours" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğrafların sana ait kalır"
          }
        }
      }
    },
    "AURUM edits on your iPhone. Photos are never uploaded unless you use an AI tool, and it always asks first. You can choose to share only some photos." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AURUM düzenlemeleri iPhone'unda yapar. Bir yapay zekâ aracı kullanmadıkça fotoğrafların asla yüklenmez ve bu araç önce her zaman izin ister. Yalnızca bazı fotoğrafları paylaşmayı seçebilirsin."
          }
        }
      }
    },
    "Page %lld of 3" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa %lld / 3"
          }
        }
      }
    },
    "Begin" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başla"
          }
        }
